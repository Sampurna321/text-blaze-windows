<Window x:Class="TextBlaze.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Blaze Settings" Height="260" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Trigger key (press after typing a shortcut to expand)" Margin="0,0,0,6"/>
        <ComboBox x:Name="TriggerCombo" Margin="0,0,0,16">
            <ComboBoxItem Content="Tab" />
            <ComboBoxItem Content="Space" />
            <ComboBoxItem Content="Enter" />
        </ComboBox>

        <CheckBox x:Name="StartWithWindowsCheck" Content="Start Text Blaze when Windows starts"/>

        <TextBlock Text="Sync folder (optional — type path or paste into window)" Margin="0,16,0,4"/>
        <TextBox x:Name="SyncFolderBox" Height="28" Margin="0,0,0,16"/>

        <Button Content="Save" Click="Save_Click" Padding="10,6" HorizontalAlignment="Left"
                Margin="0,8,0,0" FontWeight="Bold"/>
    </StackPanel>
</Window>
